default_platform(:ios)

# === App Store Connect API key ===
# Reads ENV vars set in your shell or .env:
#   ASC_KEY_ID         — the Key ID shown next to the key in App Store Connect
#   ASC_ISSUER_ID      — the Issuer ID at the top of the API Keys page
#   ASC_KEY_FILEPATH   — absolute path to the AuthKey_XXXX.p8 file
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
    duration: 1200, # 20 min
    in_house: false
  )
end

platform :ios do
  desc "Dry-run: validate metadata + screenshots locally without uploading"
  lane :verify do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      run_precheck_before_submit: false,
      verify_only: true,
      force: true
    )
  end

  desc "Upload metadata + screenshots to App Store Connect (no IPA, no submit)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
      overwrite_screenshots: true
    )
  end

  desc "Upload metadata + screenshots AND submit for review"
  lane :submit do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: true,
      automatic_release: false, # set true to auto-release after approval
      run_precheck_before_submit: false,
      force: true,
      overwrite_screenshots: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
