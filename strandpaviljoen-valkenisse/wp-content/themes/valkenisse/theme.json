{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "gebroken-wit", "name": "Gebroken wit", "color": "#FCFAF5" },
				{ "slug": "zand-licht", "name": "Licht zand", "color": "#F7F1E6" },
				{ "slug": "zand", "name": "Zand", "color": "#EFE4CF" },
				{ "slug": "duin", "name": "Duin", "color": "#D8C7A3" },
				{ "slug": "helmgras", "name": "Helmgras", "color": "#6F7D45" },
				{ "slug": "zee-licht", "name": "Licht zeewater", "color": "#BFD8DA" },
				{ "slug": "zee", "name": "Zee", "color": "#2F6F7E" },
				{ "slug": "hout", "name": "Verweerd hout", "color": "#8B7B69" },
				{ "slug": "zon", "name": "Namiddagzon", "color": "#E9A55C" },
				{ "slug": "marine", "name": "Marineblauw", "color": "#1C2F41" },
				{ "slug": "inkt", "name": "Tekst", "color": "#2A3440" }
			],
			"gradients": [
				{ "slug": "hero-schaduw", "name": "Hero-schaduw", "gradient": "linear-gradient(180deg, rgba(16,26,36,.55) 0%, rgba(16,26,36,.05) 30%, rgba(16,26,36,.05) 50%, rgba(16,26,36,.6) 100%)" },
				{ "slug": "zand-naar-wit", "name": "Zand naar wit", "gradient": "linear-gradient(180deg, #F7F1E6 0%, #FCFAF5 100%)" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [ "px", "rem", "vh", "vw", "%" ],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "clamp(1.25rem, 1rem + 1vw, 2rem)" },
				{ "slug": "40", "name": "L", "size": "clamp(2rem, 1.4rem + 2.5vw, 3.5rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(3rem, 2rem + 4.5vw, 6rem)" },
				{ "slug": "60", "name": "XXL", "size": "clamp(4rem, 2.5rem + 7vw, 9rem)" }
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "fraunces",
					"name": "Fraunces (koppen)",
					"fontFamily": "Fraunces, 'Iowan Old Style', Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces-var.woff2" ]
						}
					]
				},
				{
					"slug": "figtree",
					"name": "Figtree (tekst)",
					"fontFamily": "Figtree, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree-var.woff2" ]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree-var-italic.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "0.9rem", "fluid": false },
				{ "slug": "medium", "name": "Normaal", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Groot", "size": "1.35rem", "fluid": { "min": "1.15rem", "max": "1.4rem" } },
				{ "slug": "x-large", "name": "Extra groot", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Kop", "size": "3.5rem", "fluid": { "min": "2.3rem", "max": "3.75rem" } },
				{ "slug": "hero", "name": "Hero", "size": "5.5rem", "fluid": { "min": "2.9rem", "max": "6.25rem" } }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "zacht", "name": "Zacht", "shadow": "0 1px 2px rgba(28,47,65,.06), 0 8px 30px rgba(28,47,65,.08)" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--gebroken-wit)",
			"text": "var(--wp--preset--color--inkt)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--figtree)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1.1rem, 4vw, 2.5rem)",
				"right": "clamp(1.1rem, 4vw, 2.5rem)"
			}
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--marine)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontWeight": "500",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--zee)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--marine)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--marine)",
					"text": "var(--wp--preset--color--gebroken-wit)"
				},
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": { "fontWeight": "600", "fontSize": "1rem", "lineHeight": "1.2" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--zee)",
						"text": "var(--wp--preset--color--gebroken-wit)"
					}
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--zon)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--hout)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "1rem", "fontWeight": "500" }
			},
			"core/quote": {
				"border": { "width": "0" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--fraunces)", "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.3" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--duin)" }
			},
			"core/image": {
				"border": { "radius": "14px" }
			},
			"core/details": {
				"border": { "bottom": { "color": "var(--wp--preset--color--duin)", "width": "1px", "style": "solid" } },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-hero", "title": "Pagina met grote foto bovenaan", "postTypes": [ "page" ] }
	]
}
